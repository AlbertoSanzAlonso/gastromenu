VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# El backoffice (/admin) usa este mismo proyecto.
# Crea un usuario en Authentication y aplica supabase/migrations/002_admin_access.sql

